    {"id":"s4","type":"rectangle","x":90,"y":384,"width":380,"height":82,"angle":0,"strokeColor":"#6d28d9","backgroundColor":"#ddd6fe","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":330016,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"s4t","type":"text","x":98,"y":394,"width":364,"height":62,"angle":0,"strokeColor":"#5b21b6","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":330017,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"④ PITCH DETECTION — MPM / NSDF  (or YIN)\nACF via FFT → first peak ≥ k·max (k≈0.9)\n→ PARABOLIC INTERPOLATION → f0 = fs / τ*\nconfidence = NSDF clarity","fontSize":12,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","containerId":null,"originalText":"④ PITCH DETECTION — MPM / NSDF  (or YIN)\nACF via FFT → first peak ≥ k·max (k≈0.9)\n→ PARABOLIC INTERPOLATION → f0 = fs / τ*\nconfidence = NSDF clarity","lineHeight":1.25},
