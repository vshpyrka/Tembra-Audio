    {"id":"s7t","type":"text","x":98,"y":652,"width":364,"height":36,"angle":0,"strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":330023,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"⑦ NOTE + CENTS\nn = round(69 + 12·log2(f/440)) · cents = 100·(n_float − n)","fontSize":11,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","containerId":null,"originalText":"⑦ NOTE + CENTS\nn = round(69 + 12·log2(f/440)) · cents = 100·(n_float − n)","lineHeight":1.25},
