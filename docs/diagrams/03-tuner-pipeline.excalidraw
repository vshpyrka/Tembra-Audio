    {"id":"subtitle","type":"text","x":60,"y":64,"width":1000,"height":20,"angle":0,"strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":330002,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"A time-domain periodicity detector (MPM / YIN) — not FFT peak-picking. Left column = signal pipeline; right = why + recommended config.","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"A time-domain periodicity detector (MPM / YIN) — not FFT peak-picking. Left column = signal pipeline; right = why + recommended config.","lineHeight":1.25},

