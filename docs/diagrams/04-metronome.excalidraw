    {"id":"title","type":"text","x":60,"y":28,"width":900,"height":32,"angle":0,"strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":440001,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"Drift-Free Metronome — Sample-Accurate Scheduling","fontSize":24,"fontFamily":3,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Drift-Free Metronome — Sample-Accurate Scheduling","lineHeight":1.25},
    {"id":"subtitle","type":"text","x":60,"y":64,"width":1200,"height":20,"angle":0,"strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":440002,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"The audio device's sample clock is the single source of truth. Clicks are emitted from the real-time callback by counting frames — never by a UI/OS timer.","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"The audio device's sample clock is the single source of truth. Clicks are emitted from the real-time callback by counting frames — never by a UI/OS timer.","lineHeight":1.25},

