    {"id":"et","type":"text","x":84,"y":650,"width":532,"height":36,"angle":0,"strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":440025,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"UI BEAT FLASH — derived from the presentation timestamp\n(output-latency compensated, so the flash matches the audible click)","fontSize":12,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","containerId":null,"originalText":"UI BEAT FLASH — derived from the presentation timestamp\n(output-latency compensated, so the flash matches the audible click)","lineHeight":1.4},

    {"id":"c1","type":"rectangle","x":690,"y":150,"width":630,"height":132,"angle":0,"strokeColor":"#b91c1c","backgroundColor":"#fecaca","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":440030,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"c1t","type":"text","x":706,"y":164,"width":600,"height":104,"angle":0,"strokeColor":"#7f1d1d","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":440031,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"WHY TIMERS DRIFT  (never use them)\nHandler.postDelayed · Thread.sleep · java.util.Timer · NSTimer · CADisplayLink\nrun on preemptible threads against wall-clock time →\n• JITTER (random lateness)  +  DRIFT (error accumulates every beat)\n• wrong clock: audio plays on the device SAMPLE clock, not the system clock","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"WHY TIMERS DRIFT  (never use them)\nHandler.postDelayed · Thread.sleep · java.util.Timer · NSTimer · CADisplayLink\nrun on preemptible threads against wall-clock time →\n• JITTER (random lateness)  +  DRIFT (error accumulates every beat)\n• wrong clock: audio plays on the device SAMPLE clock, not the system clock","lineHeight":1.4},
    {"id":"c2","type":"rectangle","x":690,"y":300,"width":630,"height":80,"angle":0,"strokeColor":"#c2410c","backgroundColor":"#fed7aa","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":440032,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"c2t","type":"text","x":706,"y":314,"width":600,"height":52,"angle":0,"strokeColor":"#7c2d12","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":440033,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"THE KEY TRICK\nKeep nextClickFrame as a DOUBLE accumulator and round only at emit time\n→ long-term error < 0.5 sample, forever.","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"THE KEY TRICK\nKeep nextClickFrame as a DOUBLE accumulator and round only at emit time\n→ long-term error < 0.5 sample, forever.","lineHeight":1.4},
    {"id":"c3","type":"rectangle","x":690,"y":400,"width":630,"height":110,"angle":0,"strokeColor":"#1e40af","backgroundColor":"#dbeafe","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":440034,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"c3t","type":"text","x":706,"y":414,"width":600,"height":82,"angle":0,"strokeColor":"#1e3a8a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":440035,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"CHANGES ARE LOCK-FREE\n• Tempo change → new GridState with new bpm; applies from the next beat.\n• Sound swap → decode/resample off-thread, then atomic slot[] pointer swap.\n• Accents / time-sig / subdivision → new immutable GridState, published atomically.","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"CHANGES ARE LOCK-FREE\n• Tempo change → new GridState with new bpm; applies from the next beat.\n• Sound swap → decode/resample off-thread, then atomic slot[] pointer swap.\n• Accents / time-sig / subdivision → new immutable GridState, published atomically.","lineHeight":1.4},
    {"id":"c4","type":"rectangle","x":690,"y":530,"width":630,"height":100,"angle":0,"strokeColor":"#047857","backgroundColor":"#a7f3d0","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":440036,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"c4t","type":"text","x":706,"y":544,"width":600,"height":72,"angle":0,"strokeColor":"#065f46","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":440037,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"DAW / TIMELINE SYNC\nAnchor nextClickFrame to the transport position on the SAME sample clock;\nre-anchor on start / locate / loop. Both then free-run drift-free together.","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"DAW / TIMELINE SYNC\nAnchor nextClickFrame to the transport position on the SAME sample clock;\nre-anchor on start / locate / loop. Both then free-run drift-free together.","lineHeight":1.4},
