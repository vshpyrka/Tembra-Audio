    {"id":"ctitle","type":"text","x":84,"y":368,"width":532,"height":18,"angle":0,"strokeColor":"#c4b5fd","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":440018,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"REAL-TIME AUDIO CALLBACK  —  Oboe / AVAudioSourceNode","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"REAL-TIME AUDIO CALLBACK  —  Oboe / AVAudioSourceNode","lineHeight":1.25},
    {"id":"ccode","type":"text","x":84,"y":396,"width":532,"height":140,"angle":0,"strokeColor":"#4ade80","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":440019,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"framesPerBeat = 60 / bpm · Fs / (den/4)      // double\nwhile ( nextClickFrame < framePos + numFrames ):\n    offset = round(nextClickFrame) − framePos\n    (slot, gain) = accentPattern[ clickIndex ]\n    startVoice(slot, gain, offset)           // voice pool\n    nextClickFrame += framesPerBeat          // NO DRIFT\nmix active voices → out ;   framePos += numFrames","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"framesPerBeat = 60 / bpm · Fs / (den/4)      // double\nwhile ( nextClickFrame < framePos + numFrames ):\n    offset = round(nextClickFrame) − framePos\n    (slot, gain) = accentPattern[ clickIndex ]\n    startVoice(slot, gain, offset)           // voice pool\n    nextClickFrame += framesPerBeat          // NO DRIFT\nmix active voices → out ;   framePos += numFrames","lineHeight":1.5},
