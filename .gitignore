# Pulled competitor APKs and extracted native libs (~720 MB) — reference only, never commit
reference/competitor-apps/

# macOS
.DS_Store

# Kotlin Multiplatform / Gradle / Xcode build output (for app/)
app/**/build/
app/.gradle/
app/.kotlin/
app/local.properties
app/iosApp/Pods/
app/iosApp/*.xcworkspace/xcuserdata/
app/**/*.xcuserstate
app/.idea/

# Claude Code per-machine settings (the spec-kit skills in .claude/skills/ are committed)
.claude/settings.local.json

# Native / iOS build output added by the project scaffold (001)
app/engine/build/
app/**/.cxx/
app/build-logic/build/
app/build-logic/.gradle/
app/iosApp/build/
app/iosApp/build-device/
app/iosApp/build-duo/
app/iosApp/**/xcuserdata/
app/iosApp/**/DerivedData/
*.xcuserstate

# Performance pipeline (007): derived history cache, raw round artifacts, rendered reports,
# the perf-history worktree and the uv virtualenv stay on the producing machine
app/perf/data/*
!app/perf/data/.gitkeep
app/perf/reports/
app/perf/.history/
app/perf/.venv/
app/perf/**/__pycache__/
app/tools/**/__pycache__/
app/perf/**/*.pyc
app/perf/.pytest_cache/
app/perf/*.egg-info/

# Instruments recordings (xctrace record writes <template>_<bundle>_<date>.trace bundles to the
# current directory); the perf pipeline keeps its own under app/perf/data/
*.trace/
