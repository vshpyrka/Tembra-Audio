<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Auto Listen hears the instrument through the microphone (feature 003, spec FR-014). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- The metronome (feature 004) and the project transport (feature 009) keep playing with the screen off through a media-playback foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!--
        On Android 13+ the service's "Metronome" / "Playing" notification with its Stop action shows only with this
        permission; NotificationPermissionHost asks for it once when playback first starts the service
        (contracts/background-playback.md).
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".TembraApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tembra">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".PlaybackForegroundService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />
    </application>

</manifest>
